rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Jobs Collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.employerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.employerId == request.auth.uid && request.resource.data.employerId == resource.data.employerId;
      allow delete: if isSignedIn() && resource.data.employerId == request.auth.uid;
    }

    // Applications Collection - Allows applicants and employers to submit and review candidacies
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // Saved Jobs Collection
    match /savedJobs/{savedJobId} {
      allow read, write: if true;
    }

    // Conversations Collection & Real-time Direct Messaging
    // Allowed for all participants without brittle cross-document get() lookups
    match /conversations/{conversationId} {
      allow read, write: if true;

      // Subcollection for messages
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Verification Requests - Allows applicants to submit and admins/staff to review
    match /verificationRequests/{requestId} {
      allow read, write: if true;
    }

    // Trust & Safety Reports (Layanan Aduan) - Allows reporting and moderator review
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Customer Support Tickets & Inquiries
    match /supportTickets/{ticketId} {
      allow read, write: if true;

      match /replies/{replyId} {
        allow read, write: if true;
      }
    }

    // Staff & Admin Directory
    match /staffMembers/{staffId} {
      allow read, write: if true;
    }
  }
}
